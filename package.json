{
  "name": "nowtify",
  "version": "3.4.0",
  "description": "Chrome extension that notifies you when your Twitch streamers go live",
  "author": "qyrn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "eslint": "^10.11.0",
    "globals": "^17",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
